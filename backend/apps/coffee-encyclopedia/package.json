{
  "name": "coffee-encyclopedia-api",
  "version": "1.0.0",
  "description": "Coffee Encyclopedia API using AWS Lambda and API Gateway",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "sam local start-api",
    "deploy": "sam deploy",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "clean": "rm -rf dist",
    "db:migrate": "sequelize-cli db:migrate",
    "db:seed": "sequelize-cli db:seed:all"
  },
  "dependencies": {
    "aws-lambda": "^1.0.7",
    "pg": "^8.11.3",
    "sequelize": "^6.32.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.119",
    "@types/node": "^20.5.0",
    "@types/pg": "^8.10.2",
    "@typescript-eslint/eslint-plugin": "^6.4.0",
    "@typescript-eslint/parser": "^6.4.0",
    "eslint": "^8.47.0",
    "jest": "^29.6.2",
    "sequelize-cli": "^6.6.1",
    "typescript": "^5.1.6"
  },
  "keywords": ["coffee", "api", "lambda", "serverless"],
  "author": "Coffeeks Team",
  "license": "MIT"
} 